# ============================================
# Claude Code 中国大陆修复 & 第三方模型支持
# ============================================
# 复制此文件为 .env 并修改配置
# cp .env.example .env

# ─── 中国大陆模式 ────────────────────────────
# 启用中国大陆模式（自动检测国内网络环境）
CLAUDE_CODE_CHINA_MODE=1

# 禁用非必要网络流量（避免 GFW 阻塞）
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
DISABLE_TELEMETRY=1

# 禁用代理（如果使用国内镜像，不需要额外代理）
# CLAUDE_CODE_DISABLE_PROXY=1

# ─── Anthropic 国内镜像 ──────────────────────
# 智谱 AI Anthropic 兼容端点
ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic

# 或使用 MiniMax Anthropic 兼容端点
# ANTHROPIC_BASE_URL=https://api.minimaxi.com/anthropic

# ─── 第三方模型提供商 ────────────────────────
# 使用 /provider 命令管理，或通过 Web 管理界面 http://localhost:3457

# Ollama (本地)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_DEFAULT_MODEL=qwen2.5:latest

# MiniMax
# MINIMAX_BASE_URL=https://api.minimaxi.com/anthropic
# MINIMAX_API_KEY=your-api-key
# MINIMAX_DEFAULT_MODEL=MiniMax-M2.7

# 智谱 AI
# ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# ZHIPU_API_KEY=your-api-key
# ZHIPU_DEFAULT_MODEL=glm-4-9b

# DeepSeek
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_API_KEY=your-api-key
# DEEPSEEK_DEFAULT_MODEL=deepseek-chat

# Kimi (月之暗面)
# KIMI_BASE_URL=https://api.moonshot.cn/v1
# KIMI_API_KEY=your-api-key
# KIMI_DEFAULT_MODEL=moonshot-v1-8k

# ─── 代理服务器和 Web 管理 ───────────────────
# 启动 Web 管理界面（含 API 转换代理）:
#   bun run manage:web
#
# 启动后访问:
#   http://localhost:3457     # Web 管理界面
#   http://localhost:3456     # API 转换代理

# ─── 模型选择 ─────────────────────────────────
# 通过环境变量设置默认模型
# ANTHROPIC_MODEL=MiniMax-M2.7
# ANTHROPIC_DEFAULT_HAIKU_MODEL=MiniMax-M2.7
# ANTHROPIC_DEFAULT_SONNET_MODEL=MiniMax-M2.7
# ANTHROPIC_DEFAULT_OPUS_MODEL=MiniMax-M2.7

# 在 CLI 中使用 /model 切换模型
# 或通过 Web 界面选择模型提供商
